{
  "schemaVersion": 1,
  "id": "astatine",
  "version": "${version}",
  "name": "Astatine",
  "description": "Vulkan renderer for Minecraft 1.7.10 (luka's AGPL fork of Astatine, ported from 1.8.9).",
  "authors": ["Ren", "luka"],
  "license": "AGPL-3.0",
  "environment": "client",
  "entrypoints": {
    "preLaunch": ["yt.ren.astatine.Astatine"]
  },
  "mixins": ["astatine.mixins.json", "astatine-compat.mixins.json", "astatine-async.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-language-kotlin": "*",
    "pylon": ">=0.2.2",
    "minecraft": "1.7.10",
    "java": ">=25"
  }
}
